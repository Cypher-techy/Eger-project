NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Reuses the working Daraja naming conventions from the existing api/stkpush.js.
MPESA_ENVIRONMENT=sandbox
MPESA_ENABLED=true
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
# CustomerBuyGoodsOnline requires MPESA_PARTY_B set to your approved Safaricom Buy Goods till.
# MPESA_PARTY_B=
MPESA_CONSUMER_KEY=YOUR_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_CONSUMER_SECRET
MPESA_SHORTCODE=YOUR_SHORTCODE
MPESA_PASSKEY=YOUR_STK_PASSKEY
MPESA_CALLBACK_URL=https://YOUR_DEPLOYED_DOMAIN/api/callback

# Legacy names from the existing repository remain supported if MPESA_* is unset.
# DARAJA_ENVIRONMENT=sandbox
# DARAJA_CONSUMER_KEY=
# DARAJA_CONSUMER_SECRET=
# DARAJA_SHORTCODE=
# DARAJA_PASSKEY=

# Set only when you implement and approve the production withdrawal (B2C) flow.
ADMIN_USER_IDS=YOUR_ADMIN_AUTH_UUID
SITE_URL=http://localhost:3000
