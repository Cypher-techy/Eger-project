NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Start with Safaricom Daraja sandbox credentials. Do not commit real keys.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=YOUR_CONSUMER_KEY
DARAJA_CONSUMER_SECRET=YOUR_CONSUMER_SECRET
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=YOUR_STK_PASSKEY
DARAJA_STK_CALLBACK_URL=https://YOUR_DEPLOYED_DOMAIN/api/payments/stk-callback

# Configure only after Safaricom has approved your production M-Pesa setup.
DARAJA_B2C_INITIATOR_NAME=YOUR_B2C_INITIATOR
DARAJA_B2C_SECURITY_CREDENTIAL=YOUR_B2C_SECURITY_CREDENTIAL
DARAJA_B2C_RESULT_URL=https://YOUR_DEPLOYED_DOMAIN/api/withdrawals/b2c-result
DARAJA_B2C_TIMEOUT_URL=https://YOUR_DEPLOYED_DOMAIN/api/withdrawals/b2c-timeout

# Comma-separated Supabase Auth UUIDs for platform administrators.
ADMIN_USER_IDS=YOUR_ADMIN_AUTH_UUID
SITE_URL=http://localhost:3000