MPESA_ENVIRONMENT=sandbox
MPESA_ENABLED=true
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# For Buy Goods, set this to the till/Party B registered with Safaricom.
# MPESA_PARTY_B=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-public-domain.example/api/callback
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public Supabase anon/publishable key (never use the service role key here)
SUPABASE_ANON_KEY=

# Optional administrator identity for other application tooling
ADMIN_EMAIL=admin@kazimtaani.ac.ke
